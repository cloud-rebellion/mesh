# Mesh env keys: a reference of every variable Mesh reads, with safe defaults.
# This file is documentation, not configuration. Mesh does not load it. Export the
# variables you want in your shell, or copy this to .env and source it yourself.
# Never put a real key in a file you commit.
#
# All of these are OPTIONAL. Mesh's core (index, search, graph, MCP, TUI, web app)
# needs none of them: it runs with zero models and zero configuration.
#
# Team sync (`mesh join` / `mesh sync`) is configured per vault, not here. The
# client stores its hub URL and bearer token under <vault>/.mesh (mode 0600) when
# you redeem an invite, so there is nothing to set in the environment.

# --- Embeddings (BYOAI, optional) --------------------------------------------
# Semantic search. Point this at your OWN sovereign endpoint (a local Ollama, a
# self-hosted model server). Note: `mesh embed` POSTs note bodies to this
# endpoint, so a cloud endpoint sends vault content off-box. Keep it local to
# stay sovereign. After setting these, run `mesh embed <vault>`.
MESH_EMBED_ENDPOINT=http://localhost:11434/v1
MESH_EMBED_MODEL=nomic-embed-text
MESH_EMBED_KEY=
# Asymmetric models (nomic-style) need task prefixes; leave empty otherwise.
MESH_EMBED_DOC_PREFIX=search_document:
MESH_EMBED_QUERY_PREFIX=search_query:

# --- Rerank cross-encoder (BYOAI) --------------------------------------------
# Optional top-1 precision booster. Independent of embeddings (works with or
# without vectors). Speaks the Cohere/Jina /rerank wire format. A LOCAL server
# (see tools/rerank-server) keeps note bodies on-box; a cloud reranker POSTs the
# top ~30 candidate note bodies PER QUERY off-box, so prefer local to stay
# sovereign. Unset both to turn rerank off.
MESH_RERANK_ENDPOINT=http://127.0.0.1:8787/rerank
MESH_RERANK_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
MESH_RERANK_KEY=
# Blend: head score = a*cross-encoder + (1-a)*fused, a in [0,1]. Default 1.0
# (pure rerank; an alpha sweep on our own corpus found nothing beat it). Lower it
# only on a keyword-heavy corpus where the lexical/graph signal deserves a vote,
# and re-measure with `mesh eval` before trusting a non-default value.
MESH_RERANK_BLEND=1.0

# --- Fusion weights (optional, learned via `mesh tune`) ----------------------
# Override the built-in fusion weights (FTS / graph-BM25 / vector cosine). Leave
# unset to use the built-in defaults. Fit them to your own labelled queries with
# `mesh tune <cases.json> --test <held-out.json>` and paste the winner here.
# Note: with rerank on, fusion weights are washed out (the cross-encoder owns the
# head); these matter mainly for the vectors-on, rerank-off configuration.
MESH_WEIGHT_FTS=
MESH_WEIGHT_GRAPH=
MESH_WEIGHT_VEC=

# --- Private BYOAI endpoints (operator opt-in) -------------------------------
# Mesh runs an SSRF guard on every outbound BYOAI request, so a URL it was handed
# cannot be used to probe your host, your LAN, your Tailscale tailnet or a cloud
# metadata service and ship note content there.
#
# You do NOT need this for the setup above. An endpoint you pass on the command
# line (`mesh embed --endpoint ...`) or set in the environment (the MESH_*_ENDPOINT
# variables in this file) is operator input, and localhost / 127.0.0.1 / a LAN
# address is dialed as given.
#
# You DO need it when the endpoint lives in <vault>/.mesh/config.toml, because the
# web UI's settings page rewrites that file over PUT /api/config, so the value did
# not necessarily come from you. Set this to allow a private destination from that
# source. Same shape as MESH_ALLOW_PRIVATE_SECRET_BRIDGE.
MESH_ALLOW_PRIVATE_LLM_ENDPOINT=

# --- Existing-device browser origin aliases (hub only; disabled by default) --
# MESH_HUB_PUBLIC_URL remains canonical for default URLs and invitations.
# Optional comma-separated explicit HTTPS root origins for existing devices.
# At most eight; no wildcard/path/query/fragment/duplicate/invalid port.
# Redundant :443 is rejected; browsers strip it while the strict CLI preserves it.
# Invalid configuration disables browser handoffs and legacy token sign-in.
# A separate verified TLS/Host proxy route is required; this grants no access.
MESH_HUB_BROWSER_ORIGIN_ALIASES=

# --- Explicit invitation email (hub only; disabled by default) ---------------
# Use a separately reviewed Mesh mail relay. No other product's SMTP settings
# are inherited. TLS and certificate verification are always required.
# MESH_HUB_PUBLIC_URL must explicitly contain the HTTPS hub origin for email.
MESH_HUB_SMTP_ADDR=
MESH_HUB_SMTP_FROM=
MESH_HUB_SMTP_USERNAME=
MESH_HUB_SMTP_PASSWORD=
# starttls (e.g. port 587) or tls (implicit TLS, e.g. port 465); never plaintext.
MESH_HUB_SMTP_TLS_MODE=starttls
