# Build artifacts (anchored to repo root so they don't match cmd/mesh/ sources)
/bin/
/mesh

# Local index / vault state (derived, never committed)
*.db
*.db-wal
*.db-shm
.mesh/
.mcp.json
/.claude/

# Agent memory and per-project Claude config. Subagents with `memory: project`
# write here, and the notes are defect analyses of code that often still
# carries the defect. This subtree publishes to a PUBLIC mirror rebuilt from subtree
# HISTORY, so a single `git add -A` would carry them into every future publish
# and only a filter-repo strip could remove them again. Ignored at the source.
.claude/

# local design-hook state (holds workspace paths); never publish via the mirror
.impeccable/
